# Persistence: "api" (default, SQLite backend) or "demo" (localStorage only)
VITE_PERSISTENCE_MODE=api
# Optional override when API is on another host
# VITE_API_BASE_URL=/api

# Server (local dev / Fly.io)
# DATABASE_PATH=./data/jobsearch.sqlite
# PORT=3001

# AI (server). AI_PROVIDER: openai (default when unset) or gemini
# AI_PROVIDER=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_MODEL=
# GOOGLE_CLOUD_PROJECT=
# VERTEX_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# AI_DAILY_BUDGET_USD=
